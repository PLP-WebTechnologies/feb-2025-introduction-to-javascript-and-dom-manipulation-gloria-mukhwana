        -- HTML DOC
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Dynamic Content Manipulation</title>
    <link rel="stylesheet" type="text/css" href="styles.css"> 
    
</head>
<body>
    <h1 id="dynamicText">Initial Text</h1>
    <p id="styleModified">This paragraph's CSS will change.</p>
    <button id="addRemoveBtn">Add/Remove Element</button>
    <div id="contentArea">Initial content. Click the button to modify.</div>
    <script src="script.js"></script>
</body>
</html>


        --JAVASCRIPT
window.onload = function() {
    document.getElementById('dynamicText').textContent = 'Dynamically Changed Text!';

    document.getElementById('styleModified').style.color = 'red';
    document.getElementById('styleModified').style.fontWeight = 'bold';

    document.getElementById('addRemoveBtn').addEventListener('click', function() {
        var contentArea = document.getElementById('contentArea');
        var content = document.createElement('p');
        content.textContent = 'New Content Added!';

        if (contentArea.lastChild) {
            contentArea.removeChild(contentArea.lastChild);
            console.log('Element removed!');
        } else {
            contentArea.appendChild(content);
            console.log('Element added!');
        }
    });
};
